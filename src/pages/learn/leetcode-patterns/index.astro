---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProgressWall from '../../../components/learn/ProgressWall.astro';
import { byEpisode, countStatuses, doneCount, patternHref, STATUS_LABEL } from '../../../lib/learn';
import { allExplainers, formatRuntime } from '../../../lib/explainers';

const track = await getEntry('tracks', 'leetcode-patterns');
if (!track) throw new Error('src/content/tracks/leetcode-patterns.md is missing');
const { Content } = await render(track);

const episodes = (await getCollection('dsaEpisodes')).sort(byEpisode);
const patterns = (await getCollection('dsaPatterns')).sort((a, b) => a.data.no - b.data.no);
const counts = countStatuses(episodes);
const done = doneCount(counts);
const explainers = allExplainers();
---

<BaseLayout title={track.data.title} description={track.data.description}>
  <div class="page-container py-16">
    <header class="max-w-3xl">
      <p class="text-sm text-[var(--color-muted)]">
        <a href="/learn" class="no-underline hover:text-[var(--color-ink)]">Learn</a>
        <span aria-hidden="true"> / </span>In progress
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl">{track.data.title}</h1>
      <p class="mt-4 text-lg text-[var(--color-muted)]">{track.data.description}</p>
      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 font-mono text-sm">
        <div><dt class="inline text-[var(--color-muted)]">done </dt><dd class="inline">{done}/{episodes.length}</dd></div>
        <div><dt class="inline text-[var(--color-muted)]">solved </dt><dd class="inline">{counts.solved + done}</dd></div>
        <div><dt class="inline text-[var(--color-muted)]">prep ready </dt><dd class="inline">{counts.prep + counts.solved + done}</dd></div>
        <div><dt class="inline text-[var(--color-muted)]">patterns </dt><dd class="inline">{patterns.length}</dd></div>
      </dl>
    </header>

    <section class="mt-10" aria-label="Progress">
      <ProgressWall episodes={episodes} />
    </section>

    <div class="prose mt-10 max-w-3xl">
      <Content />
    </div>

    <section class="mt-14" aria-labelledby="patterns-heading">
      <h2 id="patterns-heading" class="text-2xl">Patterns</h2>
      <ol class="mt-6 divide-y divide-[var(--color-border)]" data-pagefind-body>
        {
          patterns.map((p) => {
            const c = p.data.counts;
            const pDone = c.recorded + c.uploaded;
            return (
              <li class="py-5">
                <a href={patternHref(p.id)} class="group flex items-baseline justify-between gap-4 no-underline">
                  <span class="flex items-baseline gap-4">
                    <span class="font-mono text-sm text-[var(--color-muted)]">
                      {String(p.data.no).padStart(2, '0')}
                    </span>
                    <span class="text-xl transition-opacity group-hover:opacity-70">{p.data.title}</span>
                  </span>
                  <span class="shrink-0 font-mono text-sm text-[var(--color-muted)]">
                    {pDone}/{p.data.episodeCount} · EP {p.data.epStart}–{p.data.epEnd}
                  </span>
                </a>
                <p class="mt-1 flex flex-wrap items-center gap-x-3 pl-10 text-xs text-[var(--color-muted)]">
                  <span>
                    {(['uploaded', 'recorded', 'solved', 'prep'] as const)
                      .filter((s) => c[s] > 0)
                      .map((s) => `${c[s]} ${STATUS_LABEL[s].toLowerCase()}`)
                      .join(' · ') || 'not started'}
                  </span>
                  {
                    explainers[p.id] && (
                      <span class="text-[var(--color-accent)]">
                        ▶ explainer {formatRuntime(explainers[p.id].duration)}
                      </span>
                    )
                  }
                </p>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</BaseLayout>
