---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProgressWall from '../../../../components/learn/ProgressWall.astro';
import TableOfContents from '../../../../components/blog/TableOfContents.astro';
import { byEpisode, episodeHref, STATUS_LABEL } from '../../../../lib/learn';

export async function getStaticPaths() {
  const patterns = await getCollection('dsaPatterns');
  return patterns.map((pattern) => ({ params: { pattern: pattern.id }, props: { pattern } }));
}

const { pattern } = Astro.props;
const episodes = (await getCollection('dsaEpisodes', ({ data }) => data.patternSlug === pattern.id)).sort(byEpisode);
const { Content, headings } = pattern.data.hasCard
  ? await render(pattern)
  : { Content: undefined, headings: [] };
const { no, title, episodeCount, epStart, epEnd, counts } = pattern.data;
const done = counts.recorded + counts.uploaded;
---

<BaseLayout
  title={`${title} · LeetCode Patterns`}
  description={`Pattern ${no} of 15: ${title}. ${episodeCount} episodes, EP ${epStart}–${epEnd}.`}
>
  <article class="page-container py-16">
    <header class="max-w-3xl">
      <p class="text-sm text-[var(--color-muted)]">
        <a href="/learn/leetcode-patterns" class="no-underline hover:text-[var(--color-ink)]">LeetCode Patterns</a>
        <span aria-hidden="true"> / </span>
        <span class="font-mono">Pattern {String(no).padStart(2, '0')}</span>
      </p>
      <h1 class="mt-3 text-4xl">{title}</h1>
      <p class="mt-3 font-mono text-sm text-[var(--color-muted)]">
        {episodeCount} episodes · EP {epStart}–{epEnd} · {done} done
      </p>
      <div class="mt-5 max-w-md">
        <ProgressWall episodes={episodes} legend={false} />
      </div>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="min-w-0">
        {
          Content ? (
            <div class="prose" data-pagefind-body data-pagefind-meta={`title:${title}`}>
              <Content />
            </div>
          ) : (
            <p class="text-[var(--color-muted)]">
              The pattern card is written when the pattern starts. Episodes below.
            </p>
          )
        }

        <section class="mt-14" aria-labelledby="episodes-heading">
          <h2 id="episodes-heading" class="text-2xl">Episodes</h2>
          <ol class="mt-6 divide-y divide-[var(--color-border)]">
            {
              episodes.map((e) => {
                const d = e.data;
                const label = `EP${String(d.ep).padStart(3, '0')}`;
                return (
                  <li class="flex items-baseline justify-between gap-4 py-4">
                    <span class="flex min-w-0 items-baseline gap-4">
                      <span class="shrink-0 font-mono text-sm text-[var(--color-muted)]">{label}</span>
                      {d.published ? (
                        <a href={episodeHref(e)} class="text-lg no-underline hover:opacity-70">
                          {d.title}
                        </a>
                      ) : (
                        <span class="text-lg text-[var(--color-muted)]">{d.title}</span>
                      )}
                    </span>
                    <span class="shrink-0 text-xs text-[var(--color-muted)]">
                      {d.difficulty && <span>{d.difficulty} · </span>}
                      {d.published ? STATUS_LABEL[d.status] : 'Coming'}
                    </span>
                  </li>
                );
              })
            }
          </ol>
        </section>
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
