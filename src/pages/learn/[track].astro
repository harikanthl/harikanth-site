---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import { checklistProgress } from '../../lib/learn';
import { formatDate } from '../../lib/format';

// Markdown-checklist tracks only. The data-driven LeetCode track has its own
// directory (learn/leetcode-patterns/), which takes precedence over this route.
export async function getStaticPaths() {
  const tracks = await getCollection('tracks', ({ data }) => !data.dataDriven);
  return tracks.map((track) => ({ params: { track: track.id }, props: { track } }));
}

const { track } = Astro.props;
const { Content, headings } = await render(track);
const { title, description, source, sourceLabel, started, status } = track.data;
const progress = checklistProgress(track.body);
const STATUS: Record<string, string> = { planned: 'Up next', active: 'In progress', done: 'Done' };
---

<BaseLayout title={title} description={description}>
  <article class="page-container py-16">
    <header class="max-w-3xl">
      <p class="text-sm text-[var(--color-muted)]">
        <a href="/learn" class="no-underline hover:text-[var(--color-ink)]">Learn</a>
        <span aria-hidden="true"> / </span>
        {STATUS[status]}
        {started && <span> · started {formatDate(started)}</span>}
      </p>
      <h1 class="mt-3 text-4xl">{title}</h1>
      <p class="mt-4 text-lg text-[var(--color-muted)]">{description}</p>
      <p class="mt-4 flex flex-wrap items-center gap-4 text-sm text-[var(--color-muted)]">
        <span class="font-mono">{progress.done}/{progress.total} done</span>
        {
          source && (
            <a href={source} rel="noopener" target="_blank" class="no-underline hover:text-[var(--color-ink)]">
              {sourceLabel ?? source} ↗
            </a>
          )
        }
      </p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="prose min-w-0" data-pagefind-body data-pagefind-meta={`title:${title}`}>
        <Content />
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
