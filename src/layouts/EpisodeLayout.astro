---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Code } from 'astro:components';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import YouTube from '../components/mdx/YouTube.astro';
import { DSA_REPO, STATUS_LABEL, episodeHref, patternHref } from '../lib/learn';
import '../styles/math.css';

type Episode = CollectionEntry<'dsaEpisodes'>;

type Props = {
  episode: Episode;
  prev?: Episode;
  next?: Episode;
};

const { episode, prev, next } = Astro.props;
const { Content, headings } = await render(episode);
const d = episode.data;
const epLabel = `EP${String(d.ep).padStart(3, '0')}`;
const description = `${d.pattern} · ${d.difficulty ?? 'Problem'} · the written version of the video, plus a tested solution.`;
const solutionUrl = `${DSA_REPO}/blob/main/${d.solutionPath}`;
---

<BaseLayout title={`${d.title} — ${d.pattern}`} description={description} type="article">
  <article class="page-container py-16">
    <header class="max-w-3xl">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-muted)]">
        <a href="/learn/leetcode-patterns" class="no-underline hover:text-[var(--color-ink)]">
          LeetCode Patterns
        </a>
        <span aria-hidden="true">/</span>
        <a href={patternHref(d.patternSlug)} class="no-underline hover:text-[var(--color-ink)]">
          {d.pattern}
        </a>
        <span aria-hidden="true">/</span>
        <span class="font-mono">{epLabel}</span>
      </p>
      <h1 class="mt-3 text-4xl">{d.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        {d.difficulty && <span class="pill">{d.difficulty}</span>}
        <span class="pill">{STATUS_LABEL[d.status]}</span>
        {
          d.links.map((link) => (
            <a href={link} rel="noopener" target="_blank" class="pill pill-link no-underline">
              {new URL(link).hostname.replace('www.', '')} ↗
            </a>
          ))
        }
      </div>
    </header>

    {d.youtubeId && (
      <div class="max-w-3xl">
        <YouTube id={d.youtubeId} title={`${epLabel} · ${d.title}`} />
      </div>
    )}

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="min-w-0">
        <div class="prose" data-pagefind-body data-pagefind-meta={`title:${d.title}`}>
          <Content />
        </div>

        {
          d.solution && (
            <section class="mt-14" id="solution">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="text-2xl">Solution</h2>
                <a
                  href={solutionUrl}
                  rel="noopener"
                  target="_blank"
                  class="text-sm text-[var(--color-muted)] no-underline hover:text-[var(--color-ink)]"
                >
                  {d.solutionPath} on GitHub ↗
                </a>
              </div>
              <p class="mt-2 text-sm text-[var(--color-muted)]">
                Tests are in the same file, written before the solution. Run them with{' '}
                <code>pytest {d.solutionPath} -q</code>.
              </p>
              <div class="learn-code mt-6">
                <Code
                  code={d.solution}
                  lang="python"
                  themes={{ light: 'github-light', dark: 'github-dark' }}
                  wrap
                />
              </div>
            </section>
          )
        }

        <nav class="mt-16 flex justify-between gap-6 border-t border-[var(--color-border)] pt-8 text-sm" aria-label="Episode">
          <div>
            {
              prev && (
                <a href={prev.data.published ? episodeHref(prev) : patternHref(prev.data.patternSlug)} class="no-underline">
                  <span class="block text-[var(--color-muted)]">← Previous</span>
                  <span class="mt-1 block text-[var(--color-ink)]">{prev.data.title}</span>
                </a>
              )
            }
          </div>
          <div class="text-right">
            {
              next && (
                <a href={next.data.published ? episodeHref(next) : patternHref(next.data.patternSlug)} class="no-underline">
                  <span class="block text-[var(--color-muted)]">Next →</span>
                  <span class="mt-1 block text-[var(--color-ink)]">{next.data.title}</span>
                </a>
              )
            }
          </div>
        </nav>
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .pill-link:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
  }

  .learn-code .astro-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    padding: 1rem 1.25rem;
  }
  /* Shiki dual themes: switch to the dark palette with the site's theme toggle. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .learn-code .astro-code,
    :root:not([data-theme='light']) .learn-code .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
    }
  }
  :root[data-theme='dark'] .learn-code .astro-code,
  :root[data-theme='dark'] .learn-code .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
</style>
